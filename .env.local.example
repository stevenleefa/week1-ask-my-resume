# Copy this file to .env.local and fill in your key.
# Get a FREE key at https://openrouter.ai/keys — no credit card required.
# Free tier: ~20 requests/min, ~50 requests/day. Plenty for learning.

OPENROUTER_API_KEY=
# Optional: override the provider. Anything speaking the OpenAI chat-completions
# format works (Groq, Together, Ollama at http://localhost:11434/v1, ...).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=

# Optional: comma-separated model list. First is primary, rest are fallbacks.
# "openrouter/free" auto-routes to the healthiest free model. Free model IDs get
# retired without warning — check https://openrouter.ai/models for current ones.
# LLM_MODEL=openrouter/free,meta-llama/llama-3.3-70b-instruct:free
